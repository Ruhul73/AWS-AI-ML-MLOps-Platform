# AWS Infrastructure & Environment Configuration
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# S3 Storage Configuration
BUCKET_PREFIX=company-mlops-churn-data

# Project 4.1: SageMaker MLOps Pipeline
SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/SageMakerExecutionRole
ENDPOINT_NAME=churn-xgb-prod
SAGEMAKER_TRAIN_INSTANCE=ml.m5.large
SAGEMAKER_DEPLOY_INSTANCE=ml.t2.medium
SAGEMAKER_SUPPRESS_V2_WARNING=1

# Project 4.2: Bedrock Serverless RAG Pipeline
BEDROCK_KB_ID=YOUR_KB_ID
BEDROCK_DS_ID=YOUR_DATA_SOURCE_ID
BEDROCK_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-3-5-sonnet-20240620-v1:0
AOSS_COLLECTION_ID=YOUR_AOSS_COLLECTION_ID

# Testing & Execution Flags
# When set to true, pipelines will execute simulation/offline fallback contracts without live AWS credentials
MOCK_AWS=false
